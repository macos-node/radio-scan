[Desktop Entry]
Type=Application
Version=1.0
Name=ntune
GenericName=Radio Tuner
Comment=Tune Nostr-published radio streams, podcasts, and npub audio feeds (n-suite / radio-scan)
Exec=@BINDIR@/ntune --tray
Icon=@ICONDIR@/ntune.svg
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=radio;stream;podcast;nostr;airplay;tuner;ndisc;
StartupNotify=true
